# ═══════════════════════════════════════
# Jal Neeti Technologies — Environment Variables
# ═══════════════════════════════════════

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_BASE_URL=https://yourapp.com

# --- WhatsApp (Gupshup) ---
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_NAME=your-gupshup-app-name
GUPSHUP_SOURCE_PHONE=918888888888
GUPSHUP_WEBHOOK_SECRET=your-webhook-secret

# --- Telephony (Exotel) ---
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SUBDOMAIN=your-company
EXOTEL_SID=your-exotel-sid
EXOTEL_CALLER_ID=your-exotel-virtual-number
EXOTEL_STATUS_CALLBACK_URL=https://yourapp.com/api/telephony/webhook

# --- NVIDIA Personaplex ---
PERSONAPLEX_API_KEY=your-nvidia-api-key
PERSONAPLEX_ENDPOINT=wss://personaplex.nvidia.com/v1/stream
PERSONAPLEX_DEFAULT_PERSONA=jalneeti-water-advisor

# --- Audio Bridge Server ---
AUDIO_BRIDGE_PORT=8999
AUDIO_BRIDGE_STREAM_URL=wss://audio.yourapp.com/stream

# --- Scheduling ---
CRON_SECRET=your-cron-secret
CALL_ADVANCE_MINUTES=2
